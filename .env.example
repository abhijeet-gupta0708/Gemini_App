# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional: comma-separated model order. The first healthy model is reused for
# later requests. Retired models answer with 404 and are skipped.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash

# Optional: time one model gets to send its first token (milliseconds).
# GEMINI_FIRST_TOKEN_TIMEOUT_MS=45000

# Optional: timeout for the buffered /api/chat endpoint (milliseconds).
# GEMINI_COMPLETE_TIMEOUT_MS=60000

# Optional: change the API port (the Vite proxy expects 5000).
# PORT=5000
